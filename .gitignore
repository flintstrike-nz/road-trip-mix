# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# android signing keys: never commit these
*.jks
*.keystore
*.p12
rtm-signing.env

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# jam joiner bundle (built by npm run build:jam-client)
/jam-client/dist/

# android
/android/app/src/main/assets/jam-client/
/android/app/libs/
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/captures/
